{
  "name": "syntrop",
  "version": "0.2.0",
  "description": "Deterministic, local-first operational memory engine for AI coding agents. SQLite + DAGs + conflict-checked schedule.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanakml/syntrop.git"
  },
  "keywords": [
    "syntrop",
    "anti-entropy",
    "agent-memory",
    "local-first",
    "sqlite",
    "dag-planner",
    "cli",
    "developer-tools",
    "personal-operations",
    "coding-agents"
  ],
  "files": [
    "src",
    "skills",
    "assets",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "GEMINI.md",
    "CLAUDE.md",
    "docs",
    "evals",
    "CHANGELOG.md",
    ".cursor/rules/syntrop.mdc",
    ".github/copilot-instructions.md"
  ],
  "bin": {
    "syntrop": "./src/cli.ts",
    "syn": "./src/cli.ts",
    "life": "./src/cli.ts"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "syntrop": "node src/cli.ts",
    "syn": "node src/cli.ts",
    "life": "node src/cli.ts",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests examples evals",
    "format:check": "prettier --check src tests examples evals",
    "eval:list": "node evals/run.mjs list"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0"
  }
}
